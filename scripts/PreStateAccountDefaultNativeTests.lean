import STFSpec.State
import Lean.Data.Json

/-!
# Defaulted pre-transaction account read controls

Bounded native and interpreted observations over a supplied lawful tracing base.
The 81 input literals mirror `pre_state_account_default_inputs.json`; the strict reader
compares complete results against independently derived frozen integer/list values.
Errors return no StateM state. No failed-state observation or backend adapter is inferred.
Spec guidance: `STFSpec/informal/modules/EthState.md` §§3/4/7.1.
-/

open STFSpec.State STFSpec.Base Lean

private def digest (n : Nat) : Hash32 := Hash32.ofBytes32 (FixedBytes.ofNat n)
private def hashValue (h : Hash32) : Nat := h.toBytes32.toNat
private def sequence (xs : List (List Nat)) : List Nat :=
  xs.length :: xs.flatMap (fun x ↦ x.length :: x)
private def optionalValues {α : Type} (f : α → List Nat) : Option α → List Nat
  | none => [0]
  | some x => 1 :: f x
private def accountValues (a : Account) : List Nat :=
  [a.nonce, a.balance.toNat, hashValue a.codeHash]
private def errorValues : WitnessError → List Nat
  | .missing (.node h) => [0, 0, hashValue h]
  | .missing (.code h) => [0, 1, hashValue h]
  | .missing .leaf => [0, 2]
  | .malformed (.node h) => [1, 0, hashValue h]
  | .malformed (.code h) => [1, 1, hashValue h]
  | .malformed .leaf => [1, 2]
  | .unresolved h => [2, hashValue h]
private def stateErrorValues : StateError → List Nat
  | .witness e => 0 :: errorValues e
  | .balanceUnderflow => [1]
  | .balanceOverflow => [2]
  | .storageOnMissingAccount => [3]

