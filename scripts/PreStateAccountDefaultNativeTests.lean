private abbrev Trace := StateT (List Nat) Id

private def suppliedError (r : Case) : WitnessError :=
  match r.id % 7 with
  | 0 => .missing (.node r.providerAccount.codeHash)
  | 1 => .missing (.code r.providerAccount.codeHash)
  | 2 => .missing .leaf
  | 3 => .malformed (.node r.providerAccount.codeHash)
  | 4 => .malformed (.code r.providerAccount.codeHash)
  | 5 => .malformed .leaf
  | _ => .unresolved r.providerAccount.codeHash

private def provider (r : Case) : PreState Trace where
  getAccount? := fun a ↦ do
    let previous ← get
    set (previous ++ [a.toNat])
    pure <| match r.providerKind with
    | 0 => .ok none
    | 2 => .ok (some r.empty)
    | 4 => .error (suppliedError r)
    | 5 => .ok (if previous.isEmpty then none else some r.providerAccount)
    | _ => .ok (some r.providerAccount)
  getStorage := fun _ _ ↦ do
    modify (· ++ [2 ^ 200 + 1])
    pure (.error (suppliedError r))
  getCode := fun _ ↦ do
    modify (· ++ [2 ^ 200 + 2])
    pure (.error (suppliedError r))
  stateRoot := fun _ ↦ do
    modify (· ++ [2 ^ 200 + 3])
    pure (.error (suppliedError r))

private def index {K : Type} [Ord K] [Std.TransOrd K] (k : K) : WriteOrder K :=
  ⟨2 ^ 410 + 9, (∅ : Std.ExtTreeMap K Nat).insert k 7,
    (∅ : Std.ExtTreeMap Nat K).insert 7 k⟩

private def accounts (r : Case) (kind : Nat) (full : Account) :
    Std.ExtTreeMap Address (Option Account) :=
  let m := (∅ : Std.ExtTreeMap Address (Option Account)).insert (Address.ofNat r.other) none
  match kind with
  | 0 => m
  | 1 => m.insert (Address.ofNat r.address) none
  | 2 => m.insert (Address.ofNat r.address) (some r.empty)
  | _ => m.insert (Address.ofNat r.address) (some full)

private def initial (r : Case) : TxState Trace := Id.run do
  let a := Address.ofNat r.address
  let b := Address.ofNat r.other
  let k : Bytes32 := FixedBytes.ofNat 17
  let j : Bytes32 := FixedBytes.ofNat 19
  let storage := ((∅ : Std.ExtTreeMap Address (Std.ExtTreeMap Bytes32 U256)).insert a ∅)
    |>.insert b (((∅ : Std.ExtTreeMap Bytes32 U256).insert k U256.zero)
      |>.insert j (U256.ofNat (2 ^ 256 - 1)))
  let orders := (∅ : Std.ExtTreeMap Address (WriteOrder Bytes32)).insert b (index j)
  let code := (∅ : Std.ExtTreeMap Hash32 ByteArray).insert r.providerAccount.codeHash
    (ByteArray.mk #[0, 255, 128, 0])
  let clears := (∅ : Std.ExtTreeSet Address).insert b
  let reads := (∅ : Std.HashSet Address).insert b
  let sr := (∅ : Std.HashSet (Address × Bytes32)).insert (b, k)
  let cr := (∅ : Std.HashSet Hash32).insert r.providerAccount.codeHash
  let block : BlockState Trace := ⟨provider r,
    ⟨r.constsEmptyCodeHash, digest 11, digest 12, digest 13⟩,
    accounts r r.blockKind r.blockAccount, index b, storage, index b, orders,
    code, clears, reads, sr, cr, some (2 ^ 420 + 3)⟩
  let rev : TxRevertible := ⟨accounts r r.transactionKind r.transactionAccount,
    index b, storage, index b, orders, code, clears,
    ((∅ : Std.ExtTreeMap (Address × Bytes32) U256).insert (b, k) U256.zero)
      |>.insert (b, j) (U256.ofNat (2 ^ 256 - 1))⟩
  return ⟨block, rev, ⟨if r.readBefore then reads.insert a else reads, sr, cr, reads⟩⟩

private def observeIndex {K : Type} [Ord K] [Std.TransOrd K]
    (key : K → Nat) (r : WriteOrder K) : List Nat :=
  [r.next] ++ sequence (r.positions.toList.map (fun p ↦ [key p.1, p.2])) ++
    sequence (r.keysByPosition.toList.map (fun p ↦ [p.1, key p.2]))
private def observeAccounts (m : Std.ExtTreeMap Address (Option Account)) : List Nat :=
  sequence (m.toList.map (fun p ↦ p.1.toNat :: optionalValues accountValues p.2))
private def observeStorage (m : Std.ExtTreeMap Address (Std.ExtTreeMap Bytes32 U256)) :
    List Nat :=
  sequence (m.toList.map (fun p ↦ p.1.toNat ::
    sequence (p.2.toList.map (fun q ↦ [q.1.toNat, q.2.toNat]))))
private def observeOrders (m : Std.ExtTreeMap Address (WriteOrder Bytes32)) : List Nat :=
  sequence (m.toList.map (fun p ↦ p.1.toNat :: observeIndex FixedBytes.toNat p.2))
private def observeCode (m : Std.ExtTreeMap Hash32 ByteArray) : List Nat :=
  sequence (m.toList.map (fun p ↦ hashValue p.1 :: p.2.toList.map UInt8.toNat))
private def addressSet (s : Std.HashSet Address) : List Nat :=
  (s.toList.map Address.toNat).mergeSort (· ≤ ·)
private def storageSet (s : Std.HashSet (Address × Bytes32)) : List Nat :=
  sequence <| ((s.toList.map (fun p ↦ (p.1.toNat, p.2.toNat))).mergeSort
    (fun p q ↦ p.1 < q.1 || (p.1 == q.1 && p.2 ≤ q.2))).map (fun p ↦ [p.1, p.2])
private def codeSet (s : Std.HashSet Hash32) : List Nat :=
  (s.toList.map hashValue).mergeSort (· ≤ ·)

private def frame (t : TxState Trace) : List Nat :=
  let b := t.block
  let r := t.rev
  sequence [[hashValue b.consts.emptyCodeHash, hashValue b.consts.emptyTrieRoot,
      hashValue b.consts.emptyOmmerHash, hashValue b.consts.transferTopic],
    observeAccounts b.accountWrites, observeIndex Address.toNat b.accountOrder,
    observeStorage b.storageWrites, observeIndex Address.toNat b.storageAddressOrder,
    observeOrders b.storageSlotOrder, observeCode b.codeWrites,
    b.storageClears.toList.map Address.toNat, addressSet b.accountReads,
    storageSet b.storageReads, codeSet b.codeReads, optionalValues (fun n ↦ [n]) b.oldestAncestorOffset,
    observeAccounts r.accountWrites, observeIndex Address.toNat r.accountOrder,
    observeStorage r.storageWrites, observeIndex Address.toNat r.storageAddressOrder,
    observeOrders r.storageSlotOrder, observeCode r.codeWrites,
    r.storageClears.toList.map Address.toNat,
    sequence (r.transient.toList.map (fun p ↦ [p.1.1.toNat, p.1.2.toNat, p.2.toNat])),
    sequence [storageSet t.obs.storageReads, codeSet t.obs.codeReads,
      addressSet t.obs.createdAccounts]]

private def composed (r : Case) : STFSpec.State.StateM Trace (List Account) := do
  let first ← getPreStateAccount (Address.ofNat r.address)
  if r.twice then
    let second ← getPreStateAccount (Address.ofNat r.address)
    pure [first, second]
  else pure [first]

private def observe (r : Case) : Json :=
  let (result, calls) := (((composed r).run (initial r)).run).run []
  let (answers, reads, frames) := match result with
    | .ok (values, next) =>
      (values.map (fun v ↦ toJson (0 :: accountValues v)),
       values.map (fun _ ↦ toJson (addressSet next.obs.accountReads)),
       values.map (fun _ ↦ toJson (frame next)))
    | .error e => ([toJson (1 :: stateErrorValues e)], [Json.null], [Json.null])
  Json.mkObj [("case", toJson r.id), ("answers", toJson answers),
    ("calls", toJson calls), ("readStates", toJson reads), ("frames", toJson frames)]

/-- Emit every complete bounded observation. The reader checks the entire stream. -/
def main : IO Unit := do
  for r in cases do
    IO.println (observe r).compress
