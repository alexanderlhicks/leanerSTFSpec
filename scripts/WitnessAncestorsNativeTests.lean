private def bytesJson (bytes : ByteArray) : Json :=
  Json.str <| String.ofList <| bytes.data.toList.flatMap fun byte ↦
    let digit := fun n ↦ Char.ofNat (if n < 10 then 48 + n else 87 + n)
    [digit (byte.toNat / 16), digit (byte.toNat % 16)]

private def headersJson (headers : List ByteArray) : Json :=
  Json.arr (headers.map bytesJson).toArray

/-- Emit complete actual values after checking every frozen expectation. -/
def main : IO Unit := do
  for (label, headers, offset, expected) in cases do
    let actual := getWitnessAncestors headers offset
    unless actual == expected do throw (IO.userError s!"{label}: ancestor value mismatch")
    IO.println <| (Json.mkObj [
      ("id", toJson label), ("headers", headersJson headers),
      ("offset", match offset with | none => Json.null | some n => toJson n),
      ("result", headersJson actual)]).compress
