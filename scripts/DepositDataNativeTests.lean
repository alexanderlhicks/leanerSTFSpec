import Lean

/-!
# Complete compiled deposit extraction observations

Library `EthConformance`. Inputs transcribed from the independently frozen catalog;
the parser checks exact input identity and every output byte/error constructor.
Spec guidance: `STFSpec/informal/modules/EthBlock.md` §§3/4/7.
-/

open STFSpec.Block Lean

private def digit (n : Nat) : Char := Char.ofNat (if n < 10 then 48 + n else 87 + n)
private def hex (data : ByteArray) : String :=
  String.ofList (data.data.toList.flatMap fun b ↦ [digit (b.toNat / 16), digit (b.toNat % 16)])
private def nibble (c : Char) : Except String Nat :=
  if '0' ≤ c ∧ c ≤ '9' then .ok (c.toNat - 48)
  else if 'a' ≤ c ∧ c ≤ 'f' then .ok (c.toNat - 87)
  else .error "noncanonical input hex"
private def unhex : List Char → Except String (List UInt8)
  | [] => .ok []
  | a :: b :: rest => do
    let x ← nibble a
    let y ← nibble b
    return UInt8.ofNat (16 * x + y) :: (← unhex rest)
  | [_] => .error "odd input hex"
private def tag : DepositError → String
  | .length => "length"
  | .pubkeyOffset => "pubkeyOffset"
  | .wcOffset => "wcOffset"
  | .amountOffset => "amountOffset"
  | .signatureOffset => "signatureOffset"
  | .indexOffset => "indexOffset"
  | .pubkeySize => "pubkeySize"
  | .wcSize => "wcSize"
  | .amountSize => "amountSize"
  | .signatureSize => "signatureSize"
  | .indexSize => "indexSize"
private def observed : Except DepositError ByteArray → Json
  | .ok result => Json.mkObj [("ok", toJson (hex result))]
  | .error error => Json.mkObj [("error", toJson (tag error))]
private def emit (value : Json) : IO Unit := do (← IO.getStdout).putStrLn value.compress
private def emitCase (id text : String) : IO Unit := do
  let bytes ← IO.ofExcept (unhex text.toList)
  let data := bytes.toByteArray
  emit (Json.mkObj [("id", toJson id), ("hex", toJson (hex data)),
    ("actual", observed (extractDepositData data))])

