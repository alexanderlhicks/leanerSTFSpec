import STFSpec.Commit.Update
import STFSpec.Commit.Delete
import STFSpec.Commit.IncrementalMPT

/-!
# Encoded incremental-trie setter

Library `EthCommit`. The full original key is hashed once iff secured, before
empty/nonempty encoded dispatch to the public deletion/insertion providers.
The final result-map bind preserves the complete root and original secured flag.
The private copying List reference has ordinary equality for arbitrary provider
actions under plain Monad. Source value/default/encoding and mutable histories
remain separate from this already-encoded nominal projection.
Spec guidance: `STFSpec/informal/modules/EthCommit.md` C22/§7.0.10.
-/
namespace STFSpec.Commit
open STFSpec.Base STFSpec.Hash
variable {m : Type → Type} [Monad m] [KeccakQuery m]

private def dispatch
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (path : Nibbles) (encoded : Option ByteArray) :
    m (Except TrieError IncrementalMPT) :=
  ((match encoded with
    | none => erase t.root path
    | some value => if value.size = 0 then erase t.root path else put t.root path value)
    >>= fun result => pure (result.map (fun root => IncrementalMPT.mk t.secured root)))

private def runSet
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (key : ByteArray) (encoded : Option ByteArray) :
    m (Except TrieError IncrementalMPT) :=
  if t.secured then
    (KeccakQuery.keccak key >>= fun answer =>
      dispatch put erase t (bytesToNibbleList answer.toBytes.toByteArray) encoded)
  else dispatch put erase t (bytesToNibbleList key) encoded

private def dispatchReference
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (path : List (Fin 16)) (encoded : Option (List UInt8)) :
    m (Except TrieError IncrementalMPT) :=
  ((match encoded with
    | none | some [] => erase t.root (Nibbles.ofList path)
    | some (b :: bs) => put t.root (Nibbles.ofList path) (Bytes.ofList (b :: bs)).toByteArray)
    >>= fun result => pure (result.map (fun root => IncrementalMPT.mk t.secured root)))

private def reference
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (key : List UInt8) (encoded : Option (List UInt8)) :
    m (Except TrieError IncrementalMPT) :=
  if t.secured then
    (KeccakQuery.keccak (Bytes.ofList key).toByteArray >>= fun answer =>
      dispatchReference put erase t (bytesToNibbleListModel answer.toBytes.toList) encoded)
  else dispatchReference put erase t (bytesToNibbleListModel key) encoded

private theorem byte_roundtrip (b : ByteArray) :
    (Bytes.ofList b.data.toList).toByteArray = b := by
  change (Bytes.ofList (Bytes.ofByteArray b).toList).toByteArray = b
  rw [Bytes.ofList_toList, Bytes.toByteArray_ofByteArray]

private theorem bytes_empty_iff (b : ByteArray) : b.size = 0 ↔ b.data.toList = [] := by
  rw [← List.length_eq_zero_iff]
  simp only [Array.length_toList, ByteArray.size_data]

private theorem path_model (b : ByteArray) :
    bytesToNibbleList b = Nibbles.ofList (bytesToNibbleListModel b.data.toList) := by
  apply Nibbles.ext
  rw [toList_bytesToNibbleList, Nibbles.toList_ofList]

private theorem hash_path_size (h : Hash32) :
    (bytesToNibbleList h.toBytes.toByteArray).size = 64 := by
  rw [size_bytesToNibbleList, Bytes.size_toByteArray, Hash32.size_toBytes]

omit [KeccakQuery m] in
private theorem dispatch_eq_reference
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (path : Nibbles) (encoded : Option ByteArray) :
    dispatch put erase t path encoded =
      dispatchReference put erase t path.toList (encoded.map (fun v => v.data.toList)) := by
  cases encoded with
  | none => simp only [dispatch, dispatchReference, Option.map_none, Nibbles.ofList_toList]
  | some value =>
    cases hv : value.data.toList with
    | nil =>
      have hs : value.size = 0 := (bytes_empty_iff value).mpr hv
      simp only [dispatch, dispatchReference, Option.map_some, hv, hs, ite_true,
        Nibbles.ofList_toList]
    | cons b bs =>
      have hs : value.size ≠ 0 := by
        intro h
        have hnil := (bytes_empty_iff value).mp h
        rw [hv] at hnil
        contradiction
      have hb : (Bytes.ofList (b :: bs)).toByteArray = value := by
        rw [← hv, byte_roundtrip]
      simp only [dispatch, dispatchReference, Option.map_some, hv, hs, ite_false,
        Nibbles.ofList_toList, hb]

private theorem runSet_eq_reference
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (key : ByteArray) (encoded : Option ByteArray) :
    runSet put erase t key encoded =
      reference put erase t key.data.toList (encoded.map (fun v => v.data.toList)) := by
  simp only [runSet, reference, byte_roundtrip]
  split
  · congr 1
    funext answer
    rw [dispatch_eq_reference, toList_bytesToNibbleList, Bytes.toList_toByteArray]
  · rw [dispatch_eq_reference, toList_bytesToNibbleList]

private theorem runSet_emptyEncoding
    (put : Ref → Nibbles → ByteArray → m (Except TrieError Ref))
    (erase : Ref → Nibbles → m (Except TrieError Ref))
    (t : IncrementalMPT) (key : ByteArray) :
    runSet put erase t key (some ByteArray.empty) = runSet put erase t key none := by
  simp only [runSet, dispatch, ByteArray.size_empty, ite_true]

/-- Set an already-encoded value in the nominal guest trie. Pinned EELS
`src/ethereum/forks/amsterdam/incremental_mpt.py:447–470` after successful
caller-owned preencoding; absent or empty encoding selects deletion. -/
def mptSet {m : Type → Type} [Monad m] [KeccakQuery m]
    (t : IncrementalMPT) (key : ByteArray) (encoded : Option ByteArray) :
    m (Except TrieError IncrementalMPT) :=
  runSet update delete t key encoded

/-- Empty and absent encoding retain the same complete action, including the
secured key query, selected deletion and final result-map bind. -/
theorem mptSet_emptyEncoding {m : Type → Type} [Monad m] [KeccakQuery m]
    (t : IncrementalMPT) (key : ByteArray) :
    mptSet (m := m) t key (some ByteArray.empty) = mptSet t key none :=
  runSet_emptyEncoding update delete t key

/-! ### Private opaque-provider controls -/

private def bytes (xs : List UInt8) : ByteArray := xs.toByteArray
private def path (xs : List (Fin 16)) : Nibbles := Nibbles.ofList xs
private def answer (n : Nat) : Hash32 := Hash32.ofBytes32 (FixedBytes.ofNat n)
private def wireBytes (b : ByteArray) : List Nat := b.size :: b.data.toList.map UInt8.toNat
private def wireHash (h : Hash32) : List Nat := h.toBytes.toByteArray.data.toList.map UInt8.toNat
private def wireEnc (e : Enc) : List Nat := wireBytes e.rlp ++
  match e.hash? with | none => [0] | some h => 1 :: wireHash h
private def wirePath (p : Nibbles) : List Nat := p.size :: p.toList.map Fin.val
private def wireRef (root : Ref) : List Nat :=
  match root with
  | none => [0]
  | some (.hashed h) => 1 :: wireHash h
  | some (.leaf p v e) => 2 :: wirePath p ++ wireBytes v ++ wireEnc e
  | some (.ext p c e) => 3 :: wirePath p ++ wireRef (some c) ++ wireEnc e
  | some (.branch xs v e) => 4 :: xs.size ::
      (List.ofFn (fun i : Fin xs.size => wireRef xs[i])).flatten ++ wireBytes v ++ wireEnc e
termination_by sizeOf root
decreasing_by
  · simp only [Option.some.sizeOf_spec, Node.ext.sizeOf_spec]; omega
  · have h := Array.sizeOf_getElem xs i.val i.isLt
    simp only [Option.some.sizeOf_spec, Node.branch.sizeOf_spec, Fin.getElem_fin]; omega
private def wireMalformed : Malformed → List Nat
  | .rlp => [0]
  | .nonEmptyString => [1]
  | .compactPathList => [2]
  | .compactEmpty => [3]
  | .leafValueList => [4]
  | .pathEmpty => [5]
  | .badListLength n => [6,n]
  | .refLength n => [7,n]
  | .extChild => [8]
  | .occupancy n => [9,n]
  | .cycle => [10]
  | .branchIndex i n => [11,i,n]
  | .collapseIndex i => [12,i]
private def wireError : TrieError → List Nat
  | .missingRoot h => 0 :: wireHash h
  | .malformed why => 1 :: wireMalformed why
  | .unresolved h => 2 :: wireHash h
private def wireResult : Except TrieError IncrementalMPT → List Nat
  | .ok t => 0 :: (if t.secured then 1 else 0) :: wireRef t.root
  | .error e => 1 :: wireError e
private def wireEvents (es : List (List Nat)) : List Nat :=
  es.length :: (es.flatMap fun e => e.length :: e)
private structure TestTrace where
  events : List (List Nat)
  next : Nat
private def initial (n : Nat) : TestTrace := ⟨[[9,0,255,66]],n⟩
private def wireTrace (s : TestTrace) : List Nat := s.next :: wireEvents s.events
private def queryEvent (n : Nat) (raw : ByteArray) (h : Hash32) : List Nat :=
  [0,n] ++ wireBytes raw ++ wireHash h
private def queryAttempt (n : Nat) (raw : ByteArray) : List Nat := [3,n] ++ wireBytes raw
private def providerEvent (root : Ref) (p : Nibbles) (v : Option ByteArray) : List Nat :=
  (if v.isSome then 1 else 2) :: wireRef root ++ wirePath p ++
    (match v with | none => [] | some b => wireBytes b)
private abbrev stateQuery (base : Nat) : KeccakQuery (StateM TestTrace) :=
  ⟨fun raw s =>
    let h := answer (base+s.next)
    (h,⟨s.events ++ [queryEvent s.next raw h],s.next+1⟩)⟩
private structure Count (α : Type) where
  value : α
  events : List (List Nat)
  ticks : Nat
private instance : Monad Count where
  pure a := ⟨a,[],1⟩
  bind a k := let b := k a.value
    ⟨b.value,a.events ++ b.events,2*a.ticks+b.ticks+1⟩
private abbrev countQuery (n : Nat) : KeccakQuery Count :=
  ⟨fun raw => ⟨answer n,[queryEvent 0 raw (answer n)],5⟩⟩
private structure QueryFailure where
  ordinal : Nat
  raw : ByteArray
  observedPrefix : List (List Nat)
private def wireFailure (f : QueryFailure) : List Nat :=
  f.ordinal :: wireBytes f.raw ++ wireEvents f.observedPrefix
private abbrev Retained := ExceptT QueryFailure (StateM TestTrace)
private abbrev retainedQuery (base failAt : Nat) : KeccakQuery Retained :=
  ⟨fun raw => ExceptT.mk fun s =>
    if s.next = failAt then
      let events := s.events ++ [queryAttempt s.next raw]
      (.error ⟨s.next,raw,events⟩,⟨events,s.next+1⟩)
    else
      let h := answer (base+s.next)
      (.ok h,⟨s.events ++ [queryEvent s.next raw h],s.next+1⟩)⟩
private abbrev Absent := StateT TestTrace (Except QueryFailure)
private abbrev absentQuery (base failAt : Nat) : KeccakQuery Absent :=
  ⟨fun raw s =>
    if s.next = failAt then
      .error ⟨s.next,raw,s.events ++ [queryAttempt s.next raw]⟩
    else
      let h := answer (base+s.next)
      .ok (h,⟨s.events ++ [queryEvent s.next raw h],s.next+1⟩)⟩
private def retainedWire (r : Except QueryFailure (Except TrieError IncrementalMPT))
    (s : TestTrace) : List Nat :=
  match r with
  | .ok t => 0 :: wireResult t ++ wireTrace s
  | .error f => 1 :: wireFailure f ++ wireTrace s
private def absentWire (r : Except QueryFailure
    (Except TrieError IncrementalMPT × TestTrace)) : List Nat :=
  match r with
  | .ok (t,s) => 0 :: wireResult t ++ wireTrace s
  | .error f => 1 :: wireFailure f
private structure OpaqueCase where
  secured : Bool
  root : Ref
  key : ByteArray
  encoded : Option ByteArray
  base : Nat
  seed : Nat
  queries : List ByteArray
  output : Except TrieError Ref
private def spy {n : Type → Type} [Monad n] [MonadStateOf TestTrace n]
    [KeccakQuery n] (c : OpaqueCase) (root : Ref) (p : Nibbles) (v : Option ByteArray) :
    n (Except TrieError Ref) := do
  modify (fun s : TestTrace => { s with events := s.events ++ [providerEvent root p v] })
  for raw in c.queries do
    let _ ← KeccakQuery.keccak raw
  pure c.output
private def opaqueObserve (c : OpaqueCase) (copied : Bool) : List Nat :=
  letI := stateQuery c.base
  let put := fun r p v => spy c r p (some v)
  let erase := fun r p => spy c r p none
  let t := IncrementalMPT.mk c.secured c.root
  let action : StateM TestTrace (Except TrieError IncrementalMPT) :=
    if copied then reference put erase t c.key.data.toList
      (c.encoded.map (fun b => b.data.toList)) else runSet put erase t c.key c.encoded
  let (r,s) := action.run (initial c.seed)
  wireResult r ++ wireTrace s
private def countProvider (c : OpaqueCase) (r : Ref) (p : Nibbles)
    (v : Option ByteArray) : Count (Except TrieError Ref) :=
  ⟨c.output,[providerEvent r p v],5⟩
private def opaqueCount (c : OpaqueCase) (copied : Bool) : List Nat :=
  letI := countQuery (c.base+c.seed)
  let put := fun r p v => countProvider c r p (some v)
  let erase := fun r p => countProvider c r p none
  let t := IncrementalMPT.mk c.secured c.root
  let action : Count (Except TrieError IncrementalMPT) :=
    if copied then reference put erase t c.key.data.toList
      (c.encoded.map (fun b => b.data.toList)) else runSet put erase t c.key c.encoded
  let bad : Count (Except TrieError IncrementalMPT) :=
    if t.secured then
      ((KeccakQuery.keccak c.key >>= fun h =>
        match c.encoded with
        | none => erase t.root (bytesToNibbleList h.toBytes.toByteArray)
        | some v => if v.size = 0 then erase t.root (bytesToNibbleList h.toBytes.toByteArray)
          else put t.root (bytesToNibbleList h.toBytes.toByteArray) v) >>=
        fun r => pure (r.map (IncrementalMPT.mk t.secured)))
    else dispatch put erase t (bytesToNibbleList c.key) c.encoded
  if wireResult bad.value == wireResult action.value then
    wireResult action.value ++ [action.ticks,bad.ticks] ++ wireEvents action.events
  else []
private def opaqueRetained (c : OpaqueCase) (failAt : Nat) (copied : Bool) : List Nat :=
  letI := retainedQuery c.base failAt
  let put := fun r p v => spy c r p (some v)
  let erase := fun r p => spy c r p none
  let t := IncrementalMPT.mk c.secured c.root
  let action : Retained (Except TrieError IncrementalMPT) :=
    if copied then reference put erase t c.key.data.toList
      (c.encoded.map (fun b => b.data.toList)) else runSet put erase t c.key c.encoded
  let (r,s) := action.run.run (initial c.seed)
  retainedWire r s
private def opaqueAbsent (c : OpaqueCase) (failAt : Nat) (copied : Bool) : List Nat :=
  letI := absentQuery c.base failAt
  let put := fun r p v => spy c r p (some v)
  let erase := fun r p => spy c r p none
  let t := IncrementalMPT.mk c.secured c.root
  let action : Absent (Except TrieError IncrementalMPT) :=
    if copied then reference put erase t c.key.data.toList
      (c.encoded.map (fun b => b.data.toList)) else runSet put erase t c.key c.encoded
  absentWire (action.run (initial c.seed))
private structure OpaqueRow where
  input : OpaqueCase
  normal : List Nat
  counted : List Nat
  failures : List (List Nat × List Nat)

