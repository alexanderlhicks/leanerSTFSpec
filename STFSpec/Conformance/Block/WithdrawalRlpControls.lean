import STFSpec.Block

/-!
# Withdrawal RLP complete controls

Library `EthConformance`. All fifty whole inputs and expected bytes were calculated
independently before implementation. Controls compare every field and byte.
Spec guidance: `STFSpec/informal/modules/EthBlock.md` §§3–7.
-/

namespace STFSpec.Conformance.Block.WithdrawalRlpControls

open STFSpec.Base STFSpec.Block STFSpec.Codec

private def leaf : RlpItem → Option (List Nat)
  | .bytes b => some (b.data.toList.map UInt8.toNat)
  | .list _ => none

private def control (i v : Nat) (address : List UInt8) (amount : Nat)
    (raw encoded : List (List Nat)) (payload wire : List Nat) : Bool :=
  match U64.ofNat? i, U64.ofNat? v, Address.ofBytes? (Bytes.ofList address),
      U64.ofNat? amount with
  | some index, some validatorIndex, some addr, some value =>
      let w := Withdrawal.mk index validatorIndex addr value
      let observed := (w.index.toNat, w.validatorIndex.toNat,
        w.address.toBytes.toList.map UInt8.toNat, w.amount.toNat)
      match RlpEncode.toRlp w with
      | .list fields =>
          observed == (i, v, address.map UInt8.toNat, amount) &&
          fields.map leaf == raw.map some &&
          fields.map (fun f ↦ (Rlp.encode f).data.toList.map UInt8.toNat) == encoded &&
          (Rlp.encodePayloadModel fields).map UInt8.toNat == payload &&
          (Rlp.encodeOf w).data.toList.map UInt8.toNat == wire
      | .bytes _ => false
  | _, _, _, _ => false

/- The literals retain minimal word digits, every address byte, ordered field wires,
joined payloads and complete outer wires. No expectation calls the target encoder. -/

