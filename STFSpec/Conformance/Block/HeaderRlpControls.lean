import STFSpec.Block
import STFSpec.Codec

/-!
# Complete header RLP literal controls

Library `EthConformance`. All 133 complete inputs, ordered leaf payloads and
357572 wire bytes are independent mathematical literals prepared before the
adapter implementation. Strictly decoded lowercase hex strings preserve every
literal byte.
These interpreted controls claim no source-runtime or native adapter execution.
Spec guidance: `STFSpec/informal/modules/EthBlock.md` §§3–7.
-/

namespace STFSpec.Conformance.Block.HeaderRlpControls

open STFSpec.Base STFSpec.Block STFSpec.Codec

private inductive Field where
  | number (n : Nat)
  | bytes (b : List UInt8)
  deriving BEq

private def digits (runs : List (Nat × Nat)) : List UInt8 :=
  runs.flatMap fun (count, byte) ↦ List.replicate count (UInt8.ofNat byte)

private def leaves : RlpItem → Option (List (List UInt8))
  | .list xs => xs.mapM fun x ↦ match x with
      | .bytes b => some b.data.toList
      | .list _ => none
  | .bytes _ => none

private def headerFromFields : List Field → Option Header
  | [.bytes parentHash, .bytes ommersHash, .bytes coinbase, .bytes stateRoot,
    .bytes transactionsRoot, .bytes receiptRoot, .bytes bloom, .number difficulty, .number number,
    .number gasLimit, .number gasUsed, .number timestamp, .bytes extraData, .bytes prevRandao,
    .bytes nonce, .number baseFeePerGas, .bytes withdrawalsRoot, .number blobGasUsed,
    .number excessBlobGas, .bytes parentBeaconBlockRoot, .bytes requestsHash,
    .bytes blockAccessListHash, .number slotNumber] => do
      let parentHash ← Hash32.ofBytes? (Bytes.ofList parentHash)
      let ommersHash ← Hash32.ofBytes? (Bytes.ofList ommersHash)
      let coinbase ← Address.ofBytes? (Bytes.ofList coinbase)
      let stateRoot ← Hash32.ofBytes? (Bytes.ofList stateRoot)
      let transactionsRoot ← Hash32.ofBytes? (Bytes.ofList transactionsRoot)
      let receiptRoot ← Hash32.ofBytes? (Bytes.ofList receiptRoot)
      let bloom ← FixedBytes.ofBytes? (Bytes.ofList bloom)
      let timestamp ← U256.ofNat? timestamp
      let extraData := Bytes.ofList extraData
      let prevRandao ← FixedBytes.ofBytes? (Bytes.ofList prevRandao)
      let nonce ← FixedBytes.ofBytes? (Bytes.ofList nonce)
      let withdrawalsRoot ← Hash32.ofBytes? (Bytes.ofList withdrawalsRoot)
      let blobGasUsed ← U64.ofNat? blobGasUsed
      let excessBlobGas ← U64.ofNat? excessBlobGas
      let parentBeaconBlockRoot ← Hash32.ofBytes? (Bytes.ofList parentBeaconBlockRoot)
      let requestsHash ← Hash32.ofBytes? (Bytes.ofList requestsHash)
      let blockAccessListHash ← Hash32.ofBytes? (Bytes.ofList blockAccessListHash)
      let slotNumber ← U64.ofNat? slotNumber
      pure (Header.mk parentHash ommersHash coinbase stateRoot transactionsRoot receiptRoot bloom
        difficulty number gasLimit gasUsed timestamp extraData prevRandao nonce baseFeePerGas
        withdrawalsRoot blobGasUsed excessBlobGas parentBeaconBlockRoot requestsHash
        blockAccessListHash slotNumber)
  | _ => none

private def headerObserve (h : Header) : List Field := [
  .bytes h.parentHash.toBytes.toList,
  .bytes h.ommersHash.toBytes.toList,
  .bytes h.coinbase.toBytes.toList,
  .bytes h.stateRoot.toBytes.toList,
  .bytes h.transactionsRoot.toBytes.toList,
  .bytes h.receiptRoot.toBytes.toList,
  .bytes h.bloom.toBytes.toList,
  .number h.difficulty,
  .number h.number,
  .number h.gasLimit,
  .number h.gasUsed,
  .number h.timestamp.toNat,
  .bytes h.extraData.toList,
  .bytes h.prevRandao.toBytes.toList,
  .bytes h.nonce.toBytes.toList,
  .number h.baseFeePerGas,
  .bytes h.withdrawalsRoot.toBytes.toList,
  .number h.blobGasUsed.toNat,
  .number h.excessBlobGas.toNat,
  .bytes h.parentBeaconBlockRoot.toBytes.toList,
  .bytes h.requestsHash.toBytes.toList,
  .bytes h.blockAccessListHash.toBytes.toList,
  .number h.slotNumber.toNat]

private def headerControl (values : List Field) (model : List (List UInt8))
    (wire : List UInt8) : Bool :=
  match headerFromFields values with
  | none => false
  | some h =>
      headerObserve h == values &&
      leaves (RlpEncode.toRlp h) == some model &&
      leaves (RlpEncode.toRlp (ParentHeader.amsterdam h)) == some model &&
      (Rlp.encodeOf h).data.toList == wire &&
      (Rlp.encodeOf (ParentHeader.amsterdam h)).data.toList == wire

private def prevHeaderFromFields : List Field → Option PrevHeader
  | [.bytes parentHash, .bytes ommersHash, .bytes coinbase, .bytes stateRoot,
    .bytes transactionsRoot, .bytes receiptRoot, .bytes bloom, .number difficulty, .number number,
    .number gasLimit, .number gasUsed, .number timestamp, .bytes extraData, .bytes prevRandao,
    .bytes nonce, .number baseFeePerGas, .bytes withdrawalsRoot, .number blobGasUsed,
    .number excessBlobGas, .bytes parentBeaconBlockRoot, .bytes requestsHash] => do
      let parentHash ← Hash32.ofBytes? (Bytes.ofList parentHash)
      let ommersHash ← Hash32.ofBytes? (Bytes.ofList ommersHash)
      let coinbase ← Address.ofBytes? (Bytes.ofList coinbase)
      let stateRoot ← Hash32.ofBytes? (Bytes.ofList stateRoot)
      let transactionsRoot ← Hash32.ofBytes? (Bytes.ofList transactionsRoot)
      let receiptRoot ← Hash32.ofBytes? (Bytes.ofList receiptRoot)
      let bloom ← FixedBytes.ofBytes? (Bytes.ofList bloom)
      let timestamp ← U256.ofNat? timestamp
      let extraData := Bytes.ofList extraData
      let prevRandao ← FixedBytes.ofBytes? (Bytes.ofList prevRandao)
      let nonce ← FixedBytes.ofBytes? (Bytes.ofList nonce)
      let withdrawalsRoot ← Hash32.ofBytes? (Bytes.ofList withdrawalsRoot)
      let blobGasUsed ← U64.ofNat? blobGasUsed
      let excessBlobGas ← U64.ofNat? excessBlobGas
      let parentBeaconBlockRoot ← Hash32.ofBytes? (Bytes.ofList parentBeaconBlockRoot)
      let requestsHash ← Hash32.ofBytes? (Bytes.ofList requestsHash)
      pure (PrevHeader.mk parentHash ommersHash coinbase stateRoot transactionsRoot receiptRoot
        bloom difficulty number gasLimit gasUsed timestamp extraData prevRandao nonce baseFeePerGas
        withdrawalsRoot blobGasUsed excessBlobGas parentBeaconBlockRoot requestsHash)
  | _ => none

private def prevHeaderObserve (h : PrevHeader) : List Field := [
  .bytes h.parentHash.toBytes.toList,
  .bytes h.ommersHash.toBytes.toList,
  .bytes h.coinbase.toBytes.toList,
  .bytes h.stateRoot.toBytes.toList,
  .bytes h.transactionsRoot.toBytes.toList,
  .bytes h.receiptRoot.toBytes.toList,
  .bytes h.bloom.toBytes.toList,
  .number h.difficulty,
  .number h.number,
  .number h.gasLimit,
  .number h.gasUsed,
  .number h.timestamp.toNat,
  .bytes h.extraData.toList,
  .bytes h.prevRandao.toBytes.toList,
  .bytes h.nonce.toBytes.toList,
  .number h.baseFeePerGas,
  .bytes h.withdrawalsRoot.toBytes.toList,
  .number h.blobGasUsed.toNat,
  .number h.excessBlobGas.toNat,
  .bytes h.parentBeaconBlockRoot.toBytes.toList,
  .bytes h.requestsHash.toBytes.toList]

private def prevHeaderControl (values : List Field) (model : List (List UInt8))
    (wire : List UInt8) : Bool :=
  match prevHeaderFromFields values with
  | none => false
  | some h =>
      prevHeaderObserve h == values &&
      leaves (RlpEncode.toRlp h) == some model &&
      leaves (RlpEncode.toRlp (ParentHeader.bpo5 h)) == some model &&
      (Rlp.encodeOf h).data.toList == wire &&
      (Rlp.encodeOf (ParentHeader.bpo5 h)).data.toList == wire

-- Literal bytes are lowercase hex strings, which elaborate as single tokens.
-- `hex` yields `[]` on an odd length or a non-hex digit; the guard after the
-- literals requires every hex literal to decode to a non-empty list.
private def hexDigit? (c : Char) : Option Nat :=
  if '0' ≤ c ∧ c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'a' ≤ c ∧ c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
  else none

private def hexBytes? : List Char → Option (List UInt8)
  | [] => some []
  | a :: b :: cs => do
    let x ← hexDigit? a
    let y ← hexDigit? b
    let rest ← hexBytes? cs
    pure (UInt8.ofNat (16 * x + y) :: rest)
  | [_] => none

private def hex (s : String) : List UInt8 := (hexBytes? s.toList).getD []

#guard hexBytes? "00ff7f0a".toList == some [0, 255, 127, 10]
#guard (hexBytes? "0".toList).isNone && (hexBytes? "0g".toList).isNone
#guard (hexBytes? "FF".toList).isNone && hex "abc" == []

