import STFSpec.Block

/-!
# Receipt RLP model and complete wire controls

Library `EthConformance`. Private clients use the Block facade. The frozen inputs
and wire literals come from an independent RLP model and comparison with the pinned
source in both locked modes.
Spec guidance: `STFSpec/informal/modules/EthBlock.md` §§3–7.
-/

namespace STFSpec.Conformance.Block.ReceiptRlpControls

open STFSpec.Base STFSpec.Block STFSpec.Codec STFSpec.Vm.Core

private theorem named_instance :
    (inferInstance : RlpEncode Receipt) = Receipt.instRlpEncode := rfl

private def logModel (entry : Log) : RlpItem :=
  .list [.bytes entry.address.toBytes.toByteArray,
    .list (entry.topics.toList.map fun hash => .bytes hash.toBytes.toByteArray),
    .bytes entry.data.toByteArray]

private def receiptModel (receipt : Receipt) : RlpItem :=
  .list [if receipt.succeeded then .bytes ⟨#[1]⟩ else .bytes ByteArray.empty,
    Rlp.ofNat receipt.cumulativeGasUsed,
    .bytes receipt.bloom.toBytes.toByteArray,
    .list (receipt.logs.toList.map logModel)]

private theorem complete_model (receipt : Receipt) :
    RlpEncode.toRlp receipt = receiptModel receipt := rfl

private theorem complete_wire_model (receipt : Receipt) :
    (Rlp.encodeOf receipt).data.toList = Rlp.encodeModel (receiptModel receipt) :=
  Rlp.toList_encode _

private theorem log_model_private : True := by
  fail_if_success have _ : Log → RlpItem := STFSpec.Block.logItem
  fail_if_success have _ : RlpEncode Log := inferInstance
  trivial

private def hexDigit? (c : Char) : Option Nat :=
  if '0' ≤ c ∧ c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'a' ≤ c ∧ c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
  else none

private def hexBytes? : List Char → Option (List UInt8)
  | [] => some []
  | a :: b :: cs => do
    let high ← hexDigit? a
    let low ← hexDigit? b
    let rest ← hexBytes? cs
    pure (UInt8.ofNat (16 * high + low) :: rest)
  | [_] => none

private abbrev LogBytes := List UInt8 × List (List UInt8) × List UInt8
private abbrev LogHex := String × List String × String

private def logBytes? (raw : LogHex) : Option LogBytes := do
  let (address, topics, data) := raw
  return (← hexBytes? address.toList, ← topics.mapM (hexBytes? ∘ String.toList),
    ← hexBytes? data.toList)

private def logValue? (raw : LogBytes) : Option Log := do
  let (address, topics, data) := raw
  let emitter ← Address.ofBytes? (Bytes.ofList address)
  let ordered ← topics.mapM (Hash32.ofBytes? ∘ Bytes.ofList)
  return ⟨emitter, ordered.toArray, Bytes.ofList data⟩

private def leafBytes? : RlpItem → Option (List UInt8)
  | .bytes b => some b.data.toList
  | .list _ => none

private def logLeaves? : RlpItem → Option LogBytes
  | .list [address, .list topics, payload] => do
    return (← leafBytes? address, ← topics.mapM leafBytes?, ← leafBytes? payload)
  | _ => none

private def receiptLeaves? :
    RlpItem → Option (List UInt8 × List UInt8 × List UInt8 × List LogBytes)
  | .list [status, gas, bloom, .list entries] => do
    return (← leafBytes? status, ← leafBytes? gas, ← leafBytes? bloom,
      ← entries.mapM logLeaves?)
  | _ => none

private def control (status : Bool) (gas : Nat) (bloom : String) (logs : List LogHex)
    (statusLeaf gasLeaf wire : String) : Bool :=
  (do
    let bloomBytes ← hexBytes? bloom.toList
    let logBytes ← logs.mapM logBytes?
    let rawBloom ← FixedBytes.ofBytes? (Bytes.ofList bloomBytes)
    let rawLogs ← logBytes.mapM logValue?
    let expectedStatus ← hexBytes? statusLeaf.toList
    let expectedGas ← hexBytes? gasLeaf.toList
    let expectedWire ← hexBytes? wire.toList
    let receipt := Receipt.mk status gas rawBloom rawLogs.toArray
    pure (receiptLeaves? (RlpEncode.toRlp receipt) ==
      some (expectedStatus, expectedGas, bloomBytes, logBytes) &&
      (Rlp.encodeOf receipt).data.toList == expectedWire)).getD false

