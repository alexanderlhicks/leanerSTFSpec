import STFSpec.Block

/-!
# Block access list RLP controls

Private Block facade clients check the complete models and wire bytes, including
ordered List composition. The aggregate literal comes from the pinned EELS
records encoded by locked `ethereum-rlp` 0.1.6.
Spec guidance: `STFSpec/informal/modules/EthBlock.md` §§3–5.
-/

namespace STFSpec.Conformance.Block.BlockAccessListRlpControls

open STFSpec.Base STFSpec.Block STFSpec.Codec

private theorem storageModel (entry : StorageChange) : RlpEncode.toRlp entry =
    .list [Rlp.ofNat entry.blockAccessIndex.toNat, Rlp.ofNat entry.newValue.toNat] := rfl

private theorem balanceModel (entry : BalanceChange) : RlpEncode.toRlp entry =
    .list [Rlp.ofNat entry.blockAccessIndex.toNat, Rlp.ofNat entry.postBalance.toNat] := rfl

private theorem nonceModel (entry : NonceChange) : RlpEncode.toRlp entry =
    .list [Rlp.ofNat entry.blockAccessIndex.toNat, Rlp.ofNat entry.newNonce.toNat] := rfl

private theorem codeModel (entry : CodeChange) : RlpEncode.toRlp entry =
    .list [Rlp.ofNat entry.blockAccessIndex.toNat, .bytes entry.newCode] := rfl

private theorem slotModel (entry : SlotChanges) : RlpEncode.toRlp entry =
    .list [Rlp.ofNat entry.slot.toNat, .list (entry.changes.map RlpEncode.toRlp)] := rfl

private theorem accountModel (entry : AccountChanges) : RlpEncode.toRlp entry =
    .list [.bytes entry.address.toBytes.toByteArray,
      .list (entry.storageChanges.map RlpEncode.toRlp),
      .list (entry.storageReads.map fun slot => Rlp.ofNat slot.toNat),
      .list (entry.balanceChanges.map RlpEncode.toRlp),
      .list (entry.nonceChanges.map RlpEncode.toRlp),
      .list (entry.codeChanges.map RlpEncode.toRlp)] := rfl

private theorem outerModel (entries : BlockAccessList) : RlpEncode.toRlp entries.toList =
    .list (entries.toList.map RlpEncode.toRlp) := rfl

example : True := by
  fail_if_success have : RlpEncode BlockAccessList := inferInstance
  trivial

private def wire {α : Type} [RlpEncode α] (entry : α) : List UInt8 :=
  (Rlp.encodeOf entry).data.toList

private def codeBytes (size : Nat) : List UInt8 :=
  (List.range size).map (fun index => UInt8.ofNat (index * 17 + 128))

private def codeRow (size : Nat) : CodeChange :=
  CodeChange.mk U32.zero ⟨(codeBytes size).toArray⟩

private def storageEntry : StorageChange := StorageChange.mk U32.max (U256.ofNat 256)

private def balanceEntry : BalanceChange := BalanceChange.mk (U32.ofNat 128) U256.max

private def nonceEntry : NonceChange := NonceChange.mk U32.zero U64.max

private def zeroCode : CodeChange := CodeChange.mk U32.zero ⟨#[0]⟩

private def emptyCode : CodeChange := CodeChange.mk U32.zero ByteArray.empty

private def slotEntry : SlotChanges := SlotChanges.mk U256.max
  [storageEntry, StorageChange.mk U32.zero U256.zero, storageEntry]

private def blank : AccountChanges := AccountChanges.mk (Address.ofNat 0) [] [] [] [] []

private def rich : AccountChanges :=
  AccountChanges.mk (Address.ofNat 0x000100020300ff000100020300ff000100020300) [slotEntry]
    [U256.max, U256.zero, U256.max] [balanceEntry] [nonceEntry]
    [codeRow 56, zeroCode, codeRow 56, emptyCode]

private def storageWire : List UInt8 := [0xc8, 0x84, 0xff, 0xff, 0xff, 0xff, 0x82, 1, 0]

private def balanceWire : List UInt8 := [0xe3, 0x81, 0x80, 0xa0] ++ List.replicate 32 0xff

private def nonceWire : List UInt8 := [0xca, 0x80, 0x88] ++ List.replicate 8 0xff

private def slotWire : List UInt8 :=
  [0xf7, 0xa0] ++ List.replicate 32 0xff ++ [0xd5] ++ storageWire ++
    [0xc2, 0x80, 0x80] ++ storageWire

private def blankWire : List UInt8 :=
  [0xda, 0x94] ++ List.replicate 20 0 ++ List.replicate 5 0xc0

private def richWire : List UInt8 :=
  [0xf9, 0x01, 0x47, 0x94, 0x00, 0x01, 0x00, 0x02, 0x03, 0x00, 0xff, 0x00,
   0x01, 0x00, 0x02, 0x03, 0x00, 0xff, 0x00, 0x01, 0x00, 0x02, 0x03, 0x00,
   0xf8, 0x38, 0xf7, 0xa0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xd5, 0xc8, 0x84, 0xff, 0xff, 0xff, 0xff, 0x82, 0x01, 0x00, 0xc2, 0x80,
   0x80, 0xc8, 0x84, 0xff, 0xff, 0xff, 0xff, 0x82, 0x01, 0x00, 0xf8, 0x43,
   0xa0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x80, 0xa0, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xe4, 0xe3, 0x81, 0x80, 0xa0,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xcb, 0xca, 0x80, 0x88,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xf8, 0x80, 0xf8, 0x3b,
   0x80, 0xb8, 0x38, 0x80, 0x91, 0xa2, 0xb3, 0xc4, 0xd5, 0xe6, 0xf7, 0x08,
   0x19, 0x2a, 0x3b, 0x4c, 0x5d, 0x6e, 0x7f, 0x90, 0xa1, 0xb2, 0xc3, 0xd4,
   0xe5, 0xf6, 0x07, 0x18, 0x29, 0x3a, 0x4b, 0x5c, 0x6d, 0x7e, 0x8f, 0xa0,
   0xb1, 0xc2, 0xd3, 0xe4, 0xf5, 0x06, 0x17, 0x28, 0x39, 0x4a, 0x5b, 0x6c,
   0x7d, 0x8e, 0x9f, 0xb0, 0xc1, 0xd2, 0xe3, 0xf4, 0x05, 0x16, 0x27, 0xc2,
   0x80, 0x00, 0xf8, 0x3b, 0x80, 0xb8, 0x38, 0x80, 0x91, 0xa2, 0xb3, 0xc4,
   0xd5, 0xe6, 0xf7, 0x08, 0x19, 0x2a, 0x3b, 0x4c, 0x5d, 0x6e, 0x7f, 0x90,
   0xa1, 0xb2, 0xc3, 0xd4, 0xe5, 0xf6, 0x07, 0x18, 0x29, 0x3a, 0x4b, 0x5c,
   0x6d, 0x7e, 0x8f, 0xa0, 0xb1, 0xc2, 0xd3, 0xe4, 0xf5, 0x06, 0x17, 0x28,
   0x39, 0x4a, 0x5b, 0x6c, 0x7d, 0x8e, 0x9f, 0xb0, 0xc1, 0xd2, 0xe3, 0xf4,
   0x05, 0x16, 0x27, 0xc2, 0x80, 0x80]

#guard wire storageEntry == storageWire
#guard wire balanceEntry == balanceWire
#guard wire nonceEntry == nonceWire
#guard wire emptyCode == [0xc2, 0x80, 0x80]
#guard wire zeroCode == [0xc2, 0x80, 0x00]
#guard wire (codeRow 1) == [0xc3, 0x80, 0x81, 0x80]
#guard wire (codeRow 53) == [0xf7, 0x80, 0xb5] ++ codeBytes 53
#guard wire (codeRow 54) == [0xf8, 0x38, 0x80, 0xb6] ++ codeBytes 54
#guard wire (codeRow 55) == [0xf8, 0x39, 0x80, 0xb7] ++ codeBytes 55
#guard wire (codeRow 56) == [0xf8, 0x3b, 0x80, 0xb8, 0x38] ++ codeBytes 56
#guard wire slotEntry == slotWire
#guard wire blank == blankWire
#guard wire rich == richWire

#guard wire ((#[] : BlockAccessList).toList) == [0xc0]
#guard wire ((#[blank] : BlockAccessList).toList) == [0xdb] ++ blankWire
#guard wire ((#[blank, rich] : BlockAccessList).toList) == [0xf9, 0x01, 0x65] ++ blankWire ++ richWire
#guard wire ((#[rich, blank, rich] : BlockAccessList).toList) ==
  [0xf9, 0x02, 0xaf] ++ richWire ++ blankWire ++ richWire

end STFSpec.Conformance.Block.BlockAccessListRlpControls
