namespace STFSpec.Conformance.Precompiles.Blake2fControls

open STFSpec.Base STFSpec.Hash STFSpec.Vm.Core

private def amsterdam := STFSpec.Fork.Amsterdam.vmConfig

private def message (rounds : Nat) (flag : UInt8) (seed : Nat) : Bytes :=
  let count := [UInt8.ofNat (rounds / 2^24), UInt8.ofNat (rounds / 2^16),
    UInt8.ofNat (rounds / 2^8), UInt8.ofNat rounds]
  let words := (List.range 208).map fun i ↦ UInt8.ofNat (i * 107 + i / 7 + seed)
  Bytes.ofList (count ++ words ++ [flag])

private def badLength (size : Nat) : Bytes :=
  Bytes.ofList ((List.range size).map fun i ↦ UInt8.ofNat (i * 47))

private def meter (budget : Nat) : GasMeter := ⟨budget, 71, 89, -13, 7, 11⟩

private def raw (tariff : Nat) : VmConfig :=
  { amsterdam with
    costs := { amsterdam.costs with
      precompileBlake2FPerRound := tariff
      precompileIdentityBase := 2^281 + 41
      precompileSha256Base := 2^269 + 59 }
    stateCosts := ⟨0, 31, 9, 77⟩
    limits := ⟨8, 99, 4⟩ }

private def check (cfg : VmConfig) (data : Bytes) (budget : Nat)
    (expected : Except ExceptionalHalt (Nat × List UInt8)) : Bool :=
  let entry := meter budget
  match STFSpec.Precompiles.blake2f (m := Id) cfg data entry, expected with
  | .ok paid actual, .ok (left, output) =>
    paid.gasLeft == left && paid.stateGasLeft == entry.stateGasLeft &&
      paid.stateGasBaseline == entry.stateGasBaseline && paid.refundCounter == entry.refundCounter &&
      paid.stateGasSpilled == entry.stateGasSpilled &&
      paid.stateGasCommittedSpill == entry.stateGasCommittedSpill &&
      actual.size == 64 && actual.toList == output
  | .halt .outOfGas, .error .outOfGas => true
  | .halt .invalidParameter, .error .invalidParameter => true
  | _, _ => false

private def largePrice : Nat := 2^273 + 97
private def maxRounds : Nat := 2^32 - 1

