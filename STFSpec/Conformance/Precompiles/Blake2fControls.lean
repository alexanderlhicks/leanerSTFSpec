private def retainsQueryCounter (data : Bytes) (budget : Nat) : Bool :=
  letI : KeccakQuery (StateM Nat) := ⟨fun _ ↦ do
    modify (· + 1)
    pure (Hash32.ofBytes32 (FixedBytes.ofNat 0))⟩
  let (_, counter) :=
    (STFSpec.Precompiles.blake2f (m := StateM Nat) amsterdam data (meter budget)).run 71
  counter == 71

