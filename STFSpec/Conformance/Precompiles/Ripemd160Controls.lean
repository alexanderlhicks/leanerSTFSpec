private def retainsQueryCounter (budget : Nat) (paid : Bool) : Bool :=
  letI : KeccakQuery (StateM Nat) := ⟨fun _ ↦ do
    modify (· + 1)
    pure (Hash32.ofBytes32 (FixedBytes.ofNat 0))⟩
  let (result, counter) :=
    (STFSpec.Precompiles.ripemd160 (m := StateM Nat) amsterdam (input 56 207) (meter budget)).run 73
  counter == 73 && match result with
    | .ok _ out => paid && out.size == 32
    | .halt .outOfGas => !paid
    | .halt _ => false

#guard retainsQueryCounter 840 true
#guard retainsQueryCounter 839 false

private def signature {m : Type → Type} [Monad m] [KeccakQuery m] : VmConfig → PrecompileFn m :=
  STFSpec.Precompiles.ripemd160

