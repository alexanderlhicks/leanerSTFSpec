namespace STFSpec.Conformance.Precompiles.Ripemd160Controls

open STFSpec.Base STFSpec.Hash STFSpec.Vm.Core

private def amsterdam := STFSpec.Fork.Amsterdam.vmConfig

private def input (size salt : Nat) : Bytes :=
  Bytes.ofList ((List.range size).map fun i ↦ UInt8.ofNat (i * 113 + i / 11 + salt + (salt / 256) * i * i))

private def meter (gasLeft : Nat) : GasMeter :=
  ⟨gasLeft, 2^259 + 13, 11, -19, 17, 2^257 + 23⟩

private def raw (base perWord : Nat) : VmConfig :=
  { amsterdam with
    costs := { amsterdam.costs with
      precompileRipemd160Base := base
      precompileRipemd160PerWord := perWord
      precompileIdentityBase := 2^273 + 61
      precompileSha256Base := 2^274 + 31
      opcodeCodeCopyBase := 2^271 + 71 }
    stateCosts := ⟨0, 31, 9, 77⟩
    limits := ⟨8, 99, 4⟩ }

private def check (cfg : VmConfig) (size salt budget : Nat)
    (expected : Option (Nat × List UInt8)) : Bool :=
  let entry := meter budget
  let result : PrecompileResult := STFSpec.Precompiles.ripemd160 (m := Id) cfg (input size salt) entry
  match result, expected with
  | .ok charged actual, some (left, digest) =>
    charged.gasLeft == left && charged.stateGasLeft == entry.stateGasLeft &&
      charged.stateGasBaseline == entry.stateGasBaseline && charged.refundCounter == entry.refundCounter &&
      charged.stateGasSpilled == entry.stateGasSpilled &&
      charged.stateGasCommittedSpill == entry.stateGasCommittedSpill &&
      actual.size == 32 && actual.toList == List.replicate 12 0 ++ digest
  | .halt .outOfGas, none => true
  | _, _ => false

private def largeBase : Nat := 2^269 + 119
private def largeWord : Nat := 2^261 + 27

