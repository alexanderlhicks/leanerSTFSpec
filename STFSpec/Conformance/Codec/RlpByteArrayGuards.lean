#guard RlpDecode.ofRlp (.bytes ⟨#[]⟩) =
  (.ok ⟨#[]⟩ : Except RlpError ByteArray)
#guard encodeOf (⟨#[]⟩ : ByteArray) = ⟨#[128]⟩
#guard decodeTo ⟨#[128]⟩ = (.ok ⟨#[]⟩ : Except RlpError ByteArray)

