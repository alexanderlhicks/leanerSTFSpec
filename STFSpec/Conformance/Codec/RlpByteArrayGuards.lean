import STFSpec.Codec

/-!
# ByteArray RLP complete-result controls

Library `EthConformance`. The 54 wire vectors give 102 complete outcomes:
14 four-part payload controls, seven lists, 33 raw errors, three model lists and
three Nat contrasts. Every constructor, diagnostic and payload byte is retained.
Spec guidance: `STFSpec/informal/modules/EthCodec.md` §§3–7.
-/
namespace STFSpec.Conformance.Codec.RlpByteArrayGuards
open STFSpec.Codec STFSpec.Codec.Rlp

private local instance {α : Type} [DecidableEq α] : DecidableEq (Except RlpError α) := by
  intro a b
  cases a <;> cases b <;>
    simp only [Except.ok.injEq, Except.error.injEq, reduceCtorEq] <;> infer_instance

-- Complete constructor and byte observation; no nested deriving support.
private def leafEquals (x : RlpItem) (b : ByteArray) : Bool :=
  match x with
  | .bytes a => a == b
  | .list _ => false

set_option maxRecDepth 4096
set_option maxHeartbeats 2000000

