import STFSpec.Field

/-!
# Natural-reference inverse complete finite controls

Library `EthConformance`. Complete literal inverse results cover all 685 frozen
natural inputs under three metadata choices; independent mathematical controls.
Spec guidance: `STFSpec/informal/modules/EthField.md` §§3–7.
-/

namespace STFSpec.Conformance.Field
open STFSpec.Field

private def checkInverse (p : Nat) (hp : 1 < p) (raw canonical expected : Nat) : Bool :=
  [none, some 0, some (2 ^ 4096 + 17)].all fun metadata ↦
    letI : FieldModulus p := ⟨hp, metadata⟩
    let a : PrimeFieldRef p := PrimeFieldRef.ofNat raw
    let actual := PrimeFieldRef.inv0 a
    a.toNat == canonical && actual.toNat == expected && decide (actual.toNat < p)

