import STFSpec.Field

/-!
# Checked byte decoding finite controls

Library `EthConformance`. Complete optional natural observations under three metadata choices.
Spec guidance: `STFSpec/informal/modules/EthField.md` §§3–7.
-/

set_option maxRecDepth 10000
set_option maxHeartbeats 2000000

open STFSpec.Field
open PrimeFieldRef

private def checkRow (row : Nat × ByteArray × Option Nat) : Bool :=
  let (p, bs, expected) := row
  if hp : 1 < p then
    ([none, some 0, some (2^4096+17)] : List (Option Nat)).all fun metadata ↦
      letI : FieldModulus p := ⟨hp, metadata⟩
      (ofBytesBE? (p := p) bs).map toNat == expected
  else false

