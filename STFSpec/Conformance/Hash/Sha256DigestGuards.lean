-- Exact boundary padding; 64 bytes require a fresh 64-byte suffix block.
#guard [55, 56, 63, 64].map zeroCount = [0, 63, 56, 55]
#guard [55, 56, 63, 64].map paddedLength = [64, 128, 128, 128]
#guard (pad (ByteArray.mk #[0x12, 0x34, 0x56])).toList =
  [0x12, 0x34, 0x56, 0x80] ++ List.replicate 59 0 ++ [24]
#guard (lengthTrailer 0x20406080a0c0e).toList = [0, 0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70]
#guard bitLength (2 ^ 61 - 1) = 2 ^ 64 - 8
#guard (lengthTrailer (2 ^ 61 - 1)).toList = [255, 255, 255, 255, 255, 255, 255, 248]
#guard bitLength (2 ^ 61) = 0
#guard (lengthTrailer (2 ^ 61)).toList = List.replicate 8 0
#guard bitLength (2 ^ 61 + 1) = 8
#guard bitLength (2 ^ 64 + 0x10203) = 8 * 0x10203
#guard (lengthTrailer (2 ^ 64 + 0x10203)).toList = [0, 0, 0, 0, 0, 8, 16, 24]

-- Byte asymmetry and exact high/low word positions detect endian/order errors.
#guard parseWord 0x81 0x23 0x45 0x67 = 0x81234567
#guard [0, 1, 2, 3].map (wordByte 0x81234567) = [0x81, 0x23, 0x45, 0x67]
#guard [0, 1, 2, 3].map (wordByte 1) = [0, 0, 0, 1]
#guard parseBlock (Bytes.generate 64 UInt8.ofNat) 0 =
  #v[0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f,
     0x10111213, 0x14151617, 0x18191a1b, 0x1c1d1e1f,
